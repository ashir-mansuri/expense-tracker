/* Expense Tracker â€” black, gold and silver */
:root {
  --ink: #0A0A0B;
  --carbon: #141416;
  --carbon-2: #1C1C20;
  --hairline: rgba(255, 255, 255, 0.09);
  --gold-hair: rgba(212, 175, 55, 0.35);
  --track: rgba(255, 255, 255, 0.10);
  --gold: #D4AF37;
  --gold-bright: #F5DF8E;
  --gold-deep: #9C7A22;
  --silver: #C9CDD5;
  --silver-muted: #8B919C;
  --warn: #E5484D;
  --text: #F4F4F6;
  --text-2: #C9CDD5;
  --text-3: #8B919C;
  --radius: 22px;
  --tab-h: 64px;
  --safe-b: env(safe-area-inset-bottom, 0px);
  --safe-t: env(safe-area-inset-top, 0px);
  --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  --font-round: ui-rounded, "SF Pro Rounded", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html { height: 100%; background: var(--ink); color-scheme: dark; }
body {
  margin: 0; min-height: 100%; font-family: var(--font); color: var(--text); background: var(--ink);
  -webkit-font-smoothing: antialiased; overscroll-behavior-y: none; font-size: 16px; line-height: 1.35;
  -webkit-user-select: none; user-select: none;
}
input, textarea, select { -webkit-user-select: text; user-select: text; }
button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
h1, h2, h3, p { margin: 0; }
.num { font-variant-numeric: tabular-nums; }
.muted { color: var(--text-3); }
.gold { color: var(--gold); }
.silver { color: var(--silver); }
.warn { color: var(--warn); }
.hidden { display: none !important; }
.sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

/* ---- layout */
#app { min-height: 100vh; min-height: 100dvh; padding-bottom: calc(var(--tab-h) + var(--safe-b) + 12px); }
.topbar {
  position: sticky; top: 0; z-index: 20; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
  padding: calc(var(--safe-t) + 10px) 16px 10px; background: rgba(10, 10, 11, 0.85); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);
}
.topbar h1 { font-size: 17px; font-weight: 600; text-align: center; }
.topbar .left { justify-self: start; } .topbar .right { justify-self: end; }
.pill-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-width: 38px; height: 38px; padding: 0 12px;
  background: var(--carbon); border: 0.5px solid var(--hairline); border-radius: 999px; color: var(--gold); font-weight: 700; font-family: var(--font-round);
}
.pill-btn.icon-only { padding: 0; width: 38px; }
.screen { padding: 4px 16px 24px; display: flex; flex-direction: column; gap: 18px; }
.card {
  background: var(--carbon); border: 0.5px solid var(--hairline); border-radius: var(--radius); padding: 18px;
}
.card.gold-edge { border-color: var(--gold-hair); }
.card h2 { font-size: 17px; font-weight: 600; }
.card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
.card-head .meta { font-size: 13px; color: var(--text-3); }
.caption { font-size: 12px; color: var(--text-3); margin-top: 10px; }

/* ---- reveal + month slide */
@media (prefers-reduced-motion: no-preference) {
  .reveal { animation: reveal 0.55s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .reveal:nth-child(1) { animation-delay: 0ms } .reveal:nth-child(2) { animation-delay: 60ms } .reveal:nth-child(3) { animation-delay: 120ms }
  .reveal:nth-child(4) { animation-delay: 180ms } .reveal:nth-child(5) { animation-delay: 240ms } .reveal:nth-child(6) { animation-delay: 300ms }
  .reveal:nth-child(7) { animation-delay: 360ms } .reveal:nth-child(8) { animation-delay: 420ms } .reveal:nth-child(9) { animation-delay: 480ms }
  .slide-left { animation: slideL 0.32s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .slide-right { animation: slideR 0.32s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .donut-seg, .ring-fill { transition: stroke-dasharray 0.6s ease-out, stroke-dashoffset 0.6s ease-out; }
  .bar-fill { transition: width 0.5s ease-out; }
  .col { transform-origin: bottom; animation: grow 0.5s ease-out both; }
}
@keyframes reveal { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
@keyframes slideL { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: none; } }
@keyframes slideR { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: none; } }
@keyframes grow { from { transform: scaleY(0.2); opacity: 0.4; } to { transform: none; opacity: 1; } }

/* ---- month selector */
.month-nav { display: flex; align-items: center; gap: 8px; }
.month-nav .arrow {
  width: 48px; height: 48px; display: grid; place-items: center; flex: 0 0 auto;
}
.month-nav .arrow span { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: var(--carbon); border: 0.5px solid var(--hairline); color: var(--gold); transition: transform 0.12s; }
.month-nav .arrow:active span { transform: scale(0.88); }
.month-nav .title { flex: 1; height: 44px; display: flex; align-items: center; justify-content: center; gap: 6px; font-family: var(--font-round); font-weight: 600; font-size: 17px; position: relative; }
.month-nav .title .ic { color: var(--gold); width: 14px; height: 14px; }
.month-nav .title input[type="month"] { position: absolute; inset: 0; opacity: 0; width: 100%; height: 100%; font-size: 16px; }

/* ---- hero */
.hero {
  position: relative; overflow: hidden; border-radius: 28px; padding: 22px; isolation: isolate;
  background: linear-gradient(180deg, #1C1C20 0%, var(--ink) 100%);
  box-shadow: 0 14px 30px rgba(212, 175, 55, 0.10);
}
.hero::before { content: ""; position: absolute; inset: 0; border-radius: 28px; padding: 1px; pointer-events: none;
  background: linear-gradient(225deg, rgba(212, 175, 55, 0.55), rgba(212, 175, 55, 0.08) 50%, rgba(201, 205, 213, 0.12));
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; }
.hero .glow { position: absolute; width: 120px; height: 120px; right: -30px; top: -40px; border-radius: 50%; background: rgba(212, 175, 55, 0.30); filter: blur(36px); pointer-events: none; z-index: -1; }
.hero .row { display: flex; align-items: baseline; justify-content: space-between; }
.hero .month { color: var(--silver); font-size: 15px; font-weight: 500; }
.hero .badge { font-size: 12px; font-weight: 600; padding: 5px 10px; border-radius: 999px; border: 0.75px solid; }
.hero .badge.ok { color: var(--gold); border-color: rgba(212, 175, 55, 0.6); }
.hero .badge.over { color: var(--warn); border-color: rgba(229, 72, 77, 0.6); }
.hero .balance {
  margin-top: 22px; font-family: var(--font-round); font-weight: 800; font-size: 42px; line-height: 1.1; letter-spacing: -0.5px;
  background: linear-gradient(180deg, var(--gold-bright), var(--gold) 55%, var(--gold-deep)); -webkit-background-clip: text; background-clip: text; color: transparent;
  filter: drop-shadow(0 4px 14px rgba(212, 175, 55, 0.25)); white-space: nowrap;
}
.hero .note { margin-top: 6px; font-size: 13px; color: var(--silver-muted); }
.hero .spent { margin-top: 22px; }
.hero .figures { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-top: 22px; }
.hero .figure { display: flex; align-items: center; gap: 10px; padding: 10px; border-radius: 16px; background: rgba(255, 255, 255, 0.05); border: 0.5px solid rgba(255, 255, 255, 0.07); }
.hero .figure .ic-wrap { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; }
.hero .figure .ic-wrap.gold { background: rgba(212, 175, 55, 0.12); color: var(--gold); }
.hero .figure .ic-wrap.silver { background: rgba(201, 205, 213, 0.12); color: var(--silver); }
.hero .figure .lbl { font-size: 12px; color: var(--silver-muted); }
.hero .figure .val { font-family: var(--font-round); font-weight: 700; font-size: 15px; white-space: nowrap; }
.hero .figure .val.gold { color: var(--gold); } .hero .figure .val.silver { color: var(--silver); }

/* ---- bars */
.bar { width: 100%; background: var(--track); border-radius: 999px; overflow: hidden; }
.bar-fill { height: 100%; border-radius: 999px; }
.bar-gold { background: linear-gradient(90deg, var(--gold-bright), var(--gold)); }
.bar-silver { background: linear-gradient(90deg, #E4E7EC, var(--silver), var(--silver-muted)); }
.bar-warn { background: var(--warn); }

/* ---- horizontal strips */
.strip { display: flex; gap: 10px; overflow-x: auto; margin: 0 -16px; padding: 0 16px 4px; scrollbar-width: none; scroll-snap-type: x proximity; }
.strip::-webkit-scrollbar { display: none; }
.tile { flex: 0 0 136px; padding: 14px; border-radius: 18px; background: var(--carbon); border: 0.5px solid var(--hairline); scroll-snap-align: start; }
.tile .ic-wrap { width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; margin-bottom: 10px; }
.tile .ic-wrap.neutral { background: rgba(201, 205, 213, 0.12); color: var(--silver); }
.tile .ic-wrap.good { background: rgba(212, 175, 55, 0.12); color: var(--gold); }
.tile .ic-wrap.bad { background: rgba(229, 72, 77, 0.12); color: var(--warn); }
.tile .val { font-family: var(--font-round); font-weight: 700; font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.tile .val.good { color: var(--gold); }
.tile .lbl { font-size: 12px; color: var(--text-3); margin-top: 2px; }
.strip-label { font-size: 15px; font-weight: 600; color: var(--text-3); margin: 0 4px 8px; }
.chip { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; background: var(--carbon); border: 0.5px solid var(--hairline); }
.chip .ic { color: var(--silver); } .chip.income .ic { color: var(--gold); }
.chip .t { font-size: 13px; font-weight: 500; max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.chip .a { font-size: 11px; color: var(--text-3); }

/* ---- teaser */
.teaser { display: flex; gap: 12px; align-items: flex-start; width: 100%; text-align: left; }
.teaser .ic-wrap { flex: 0 0 30px; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: rgba(212, 175, 55, 0.12); color: var(--gold); }
.teaser p { font-size: 15px; }
.teaser .more { color: var(--gold); font-size: 12px; font-weight: 600; margin-top: 4px; }
.teaser .chev { color: var(--text-3); margin-top: 6px; }

/* ---- category rows */
.cat-list { display: flex; flex-direction: column; gap: 14px; }
.cat-row { width: 100%; text-align: left; }
.cat-row .line { display: flex; align-items: center; gap: 10px; }
.cat-row .ic-wrap { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; flex: 0 0 auto; }
.cat-row .name { flex: 1; font-size: 15px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.cat-row .amt { font-family: var(--font-round); font-weight: 600; font-size: 15px; }
.cat-row .bar { margin: 6px 0 0 36px; width: auto; }
.donut-row { display: flex; align-items: center; gap: 18px; }
.legend { flex: 1; display: flex; flex-direction: column; gap: 10px; min-width: 0; }
.legend .l { display: flex; align-items: center; gap: 8px; font-size: 13px; }
.legend .dot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; }
.legend .n { flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.legend .p { font-weight: 600; }
.donut-top { font-size: 10px; fill: var(--text-3); }
.donut-main { font-size: 13px; font-weight: 700; fill: var(--gold); font-family: var(--font-round); }
.divider { height: 0.5px; background: var(--hairline); margin: 16px 0; }
.link-btn { display: block; width: 100%; text-align: center; color: var(--gold); font-weight: 600; font-size: 13px; padding: 6px; }

/* ---- charts */
.chart .grid { stroke: var(--hairline); stroke-width: 1; }
.chart .grid.strong { stroke: rgba(255, 255, 255, 0.2); }
.chart .axis { fill: var(--text-3); font-size: 10px; }
.chart .axis.tiny { font-size: 8px; }
.chart .avg { stroke: rgba(212, 175, 55, 0.7); stroke-dasharray: 4 4; }
.legend-inline { display: flex; gap: 14px; font-size: 12px; color: var(--text-3); margin-top: 6px; }
.legend-inline span::before { content: ""; display: inline-block; width: 10px; height: 10px; border-radius: 3px; margin-right: 6px; vertical-align: -1px; }
.legend-inline .li::before { background: var(--gold); } .legend-inline .le::before { background: var(--silver); }
.ring-main { font-size: 13px; font-weight: 700; font-family: var(--font-round); }
.ring-sub { font-size: 9px; fill: var(--silver-muted); }

/* ---- budgets */
.budget { display: flex; flex-direction: column; gap: 6px; }
.budget + .budget { margin-top: 14px; }
.budget .line { display: flex; align-items: center; gap: 8px; font-size: 15px; }
.budget .line .name { flex: 1; font-weight: 500; }
.budget .line .amt { font-family: var(--font-round); font-weight: 600; font-size: 14px; color: var(--text-3); }
.budget .sub { display: flex; justify-content: space-between; font-size: 12px; color: var(--text-3); }

/* ---- summary */
.sentences { display: flex; flex-direction: column; gap: 10px; }
.sentences li { display: flex; gap: 10px; list-style: none; font-size: 15px; color: var(--silver); }
.sentences li:first-child { font-weight: 500; color: var(--text); }
.sentences li::before { content: ""; flex: 0 0 5px; width: 5px; height: 5px; border-radius: 50%; background: var(--silver-muted); margin-top: 8px; }
.sentences li:first-child::before { background: var(--gold); }
.sentences ul, ul.sentences { padding: 0; margin: 0; }
.mover { display: flex; align-items: center; gap: 10px; width: 100%; text-align: left; }
.mover + .mover { margin-top: 14px; }
.mover .ic-wrap { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; }
.mover .ic-wrap.up { background: rgba(229, 72, 77, 0.12); color: var(--warn); } .mover .ic-wrap.down { background: rgba(212, 175, 55, 0.12); color: var(--gold); }
.mover .txt { flex: 1; min-width: 0; } .mover .n { font-size: 15px; font-weight: 500; } .mover .s { font-size: 12px; color: var(--text-3); }
.mover .chg { font-family: var(--font-round); font-weight: 600; font-size: 15px; }

/* ---- lists */
.list { display: flex; flex-direction: column; gap: 18px; }
.section-title { display: flex; justify-content: space-between; font-size: 13px; color: var(--text-3); text-transform: none; margin: 0 4px 8px; }
.rows { background: var(--carbon); border: 0.5px solid var(--hairline); border-radius: 18px; overflow: hidden; }
.row { display: flex; align-items: center; gap: 12px; padding: 12px 14px; width: 100%; text-align: left; border-top: 0.5px solid var(--hairline); }
.row:first-child { border-top: 0; }
.row:active { background: rgba(255, 255, 255, 0.04); }
.row .ic-wrap { width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; flex: 0 0 auto; }
.row .ic-wrap.expense { background: rgba(201, 205, 213, 0.12); color: var(--silver); }
.row .ic-wrap.income { background: rgba(212, 175, 55, 0.12); color: var(--gold); }
.row .txt { flex: 1; min-width: 0; }
.row .t { font-size: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.row .s { font-size: 12px; color: var(--text-3); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.row .amt { font-family: var(--font-round); font-weight: 600; font-size: 16px; white-space: nowrap; }
.row .amt.income { color: var(--gold); }
.row .chev { color: var(--text-3); }
.row.setting { justify-content: space-between; }
.row.setting .ic { color: var(--gold); }
.row.setting .value { color: var(--text-3); font-size: 15px; }
.row.danger { color: var(--warn); }
.row select, .row input[type="number"], .row input[type="time"] { background: transparent; border: 0; color: var(--text-2); font: inherit; text-align: right; }
.footer-note { font-size: 12px; color: var(--text-3); margin: 8px 4px 0; }

/* ---- segmented */
.seg { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; background: var(--carbon); border: 0.5px solid var(--hairline); border-radius: 12px; padding: 3px; }
.seg button { padding: 8px; border-radius: 9px; font-size: 14px; font-weight: 500; color: var(--text-3); }
.seg button.on { background: var(--carbon-2); color: var(--text); box-shadow: 0 1px 2px rgba(0, 0, 0, 0.4); }
.toolbar-row { display: flex; gap: 8px; align-items: center; }
.search { flex: 1; display: flex; align-items: center; gap: 8px; height: 40px; padding: 0 12px; background: var(--carbon); border: 0.5px solid var(--hairline); border-radius: 12px; color: var(--text-3); }
.search input { flex: 1; background: transparent; border: 0; color: var(--text); font-size: 16px; outline: none; min-width: 0; }
.select-wrap { position: relative; }
.select-wrap select { position: absolute; inset: 0; opacity: 0; width: 100%; font-size: 16px; }

/* ---- empty states */
.empty { text-align: center; padding: 28px 16px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
.empty .ic { width: 32px; height: 32px; color: var(--text-3); }
.empty h3 { font-size: 17px; font-weight: 600; }
.empty p { font-size: 15px; color: var(--text-3); max-width: 300px; }
.btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 46px; padding: 0 20px; border-radius: 999px; font-weight: 600; font-size: 16px; }
.btn.primary { background: var(--gold); color: var(--ink); }
.btn.secondary { background: var(--carbon-2); color: var(--gold); border: 0.5px solid var(--gold-hair); }
.btn.block { width: 100%; }
.btn.danger { color: var(--warn); border: 0.5px solid rgba(229, 72, 77, 0.4); }
.btn:active { transform: scale(0.98); }
.btn:disabled { opacity: 0.45; }

/* ---- tab bar */
.tabbar {
  position: fixed; left: 12px; right: 12px; bottom: calc(var(--safe-b) + 10px); height: var(--tab-h); z-index: 30;
  display: grid; grid-template-columns: repeat(5, 1fr); align-items: center;
  background: rgba(28, 28, 32, 0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
  border: 0.5px solid var(--hairline); border-radius: 999px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
}
.tabbar button { display: flex; flex-direction: column; align-items: center; gap: 3px; font-size: 10px; font-weight: 600; color: var(--text-3); height: 100%; justify-content: center; }
.tabbar button .ic { width: 22px; height: 22px; }
.tabbar button.on { color: var(--gold); }
.tabbar button.on .ic { filter: drop-shadow(0 0 8px rgba(212, 175, 55, 0.5)); }

/* ---- sheet */
.sheet-backdrop { position: fixed; inset: 0; background: rgba(0, 0, 0, 0.55); z-index: 40; opacity: 0; transition: opacity 0.25s; }
.sheet-backdrop.show { opacity: 1; }
.sheet {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 41; max-height: 92vh; max-height: 92dvh; display: flex; flex-direction: column;
  background: var(--carbon); border-radius: 24px 24px 0 0; border-top: 0.5px solid var(--hairline);
  transform: translateY(100%); transition: transform 0.32s cubic-bezier(0.2, 0.8, 0.2, 1);
  padding-bottom: var(--safe-b);
}
.sheet.show { transform: none; }
.sheet .grab { width: 36px; height: 5px; border-radius: 3px; background: rgba(255, 255, 255, 0.2); margin: 8px auto 0; }
.sheet-head { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 10px 16px; }
.sheet-head h2 { font-size: 17px; font-weight: 600; text-align: center; }
.sheet-head button { font-size: 16px; }
.sheet-head .cancel { justify-self: start; color: var(--text-3); }
.sheet-head .save { justify-self: end; color: var(--gold); font-weight: 600; }
.sheet-head .save:disabled { opacity: 0.4; }
.sheet-body { overflow-y: auto; padding: 4px 16px 24px; display: flex; flex-direction: column; gap: 16px; }
.field { display: flex; flex-direction: column; gap: 6px; }
.field label { font-size: 12px; color: var(--text-3); margin-left: 4px; }
.field .control { display: flex; align-items: center; gap: 10px; background: var(--carbon-2); border: 0.5px solid var(--hairline); border-radius: 14px; padding: 0 14px; min-height: 50px; }
.field input, .field select, .field textarea { flex: 1; background: transparent; border: 0; color: var(--text); font-size: 17px; outline: none; min-width: 0; padding: 12px 0; font-family: inherit; }
.field input.amount { font-family: var(--font-round); font-weight: 600; font-size: 24px; }
.field select { appearance: none; -webkit-appearance: none; }
.field .control .ic { color: var(--text-3); }
.field .hint { font-size: 12px; color: var(--text-3); margin-left: 4px; }
.suggest { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; }
.suggest::-webkit-scrollbar { display: none; }
.suggest button { flex: 0 0 auto; font-size: 13px; padding: 6px 12px; border-radius: 999px; background: var(--carbon-2); border: 0.5px solid var(--hairline); color: var(--text-2); }
.sheet .btn.danger { margin-top: 8px; }

/* ---- toast + banner */
.toast {
  position: fixed; left: 24px; right: 24px; bottom: calc(var(--tab-h) + var(--safe-b) + 24px); z-index: 50; text-align: center;
  padding: 10px 16px; border-radius: 999px; background: var(--carbon-2); border: 0.75px solid rgba(212, 175, 55, 0.5); color: #fff; font-size: 14px; font-weight: 500;
  box-shadow: 0 6px 12px rgba(0, 0, 0, 0.3); opacity: 0; transform: translateY(12px); transition: opacity 0.25s, transform 0.25s; pointer-events: none;
}
.toast.show { opacity: 1; transform: none; }
.banner { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 16px; background: rgba(212, 175, 55, 0.1); border: 0.5px solid var(--gold-hair); font-size: 14px; }
.banner .ic { color: var(--gold); flex: 0 0 auto; }
.banner .txt { flex: 1; }
.banner button { color: var(--gold); font-weight: 600; }

/* ---- lock */
.lock { position: fixed; inset: 0; z-index: 60; background: rgba(10, 10, 11, 0.92); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20px; padding: 24px; }
.lock .ic { width: 44px; height: 44px; color: var(--gold); }
.lock h2 { font-size: 20px; }
.lock .dots { display: flex; gap: 14px; }
.lock .dots span { width: 14px; height: 14px; border-radius: 50%; border: 1.5px solid var(--gold); }
.lock .dots span.on { background: var(--gold); }
.keypad { display: grid; grid-template-columns: repeat(3, 72px); gap: 14px; }
.keypad button { height: 72px; border-radius: 50%; background: var(--carbon); border: 0.5px solid var(--hairline); font-size: 26px; font-family: var(--font-round); }
.keypad button:active { background: var(--carbon-2); }
.keypad button.soft { background: transparent; border: 0; font-size: 15px; color: var(--text-3); }
.lock .err { color: var(--warn); font-size: 14px; min-height: 20px; }

/* ---- report (print) */
.report { background: #fff; color: #111; padding: 32px 24px; font-size: 13px; }
.report h1 { font-size: 26px; font-family: var(--font-round); }
.report .eyebrow { color: #A88A22; font-weight: 600; font-size: 11px; }
.report .meta { color: #6B6F76; font-size: 11px; margin-top: 4px; }
.report .totals { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin: 20px 0; }
.report .totals div { background: #F6F6F8; border-radius: 8px; padding: 10px; }
.report .totals .l { font-size: 10px; color: #6B6F76; } .report .totals .v { font-weight: 700; font-family: var(--font-round); font-size: 15px; }
.report h3 { font-size: 14px; margin: 20px 0 6px; }
.report table { width: 100%; border-collapse: collapse; }
.report td { padding: 5px 0; border-bottom: 0.5px solid #E3E5E8; vertical-align: middle; }
.report td.r { text-align: right; font-weight: 600; white-space: nowrap; }
.report td.m { color: #6B6F76; }
.report .rbar { height: 6px; background: #E3E5E8; border-radius: 3px; } .report .rbar div { height: 100%; background: #A88A22; border-radius: 3px; }
.report .gold { color: #A88A22; } .report .slate { color: #5B6472; } .report .red { color: #C0392B; }
.report p { line-height: 1.5; }
.report-actions { position: sticky; top: 0; display: flex; gap: 10px; padding: 12px 16px; background: var(--ink); border-bottom: 0.5px solid var(--hairline); z-index: 5; }
@media print {
  body { background: #fff; } #app > :not(.report-wrap) { display: none !important; } .report-actions, .tabbar, .toast { display: none !important; }
  .report-wrap { position: static; } .report { padding: 0; }
}
.report-wrap { position: fixed; inset: 0; z-index: 45; background: var(--ink); overflow-y: auto; }
.report-wrap .report { margin: 0 auto; max-width: 720px; }

/* ---- categories screen */
.row .budget-note { font-size: 12px; color: var(--text-3); }
.count { font-size: 14px; color: var(--text-3); font-variant-numeric: tabular-nums; }

/* ---- misc */
.flex { display: flex; align-items: center; gap: 8px; }
.grow { flex: 1; min-width: 0; }
.stack { display: flex; flex-direction: column; gap: 10px; }
.mt { margin-top: 12px; }
.ic { width: 18px; height: 18px; flex: 0 0 auto; }

/* ---- modal dialogs */
.modal-backdrop { position: fixed; inset: 0; z-index: 70; display: grid; place-items: center; padding: 24px; background: rgba(0, 0, 0, 0.6); opacity: 0; transition: opacity 0.2s; }
.modal-backdrop.show { opacity: 1; }
.modal { width: 100%; max-width: 320px; background: var(--carbon-2); border: 0.5px solid var(--hairline); border-radius: 20px; padding: 20px; text-align: center; transform: scale(0.96); transition: transform 0.2s; }
.modal-backdrop.show .modal { transform: none; }
.modal h3 { font-size: 17px; font-weight: 600; margin-bottom: 6px; }
.modal p { font-size: 14px; color: var(--text-2); }
.modal-actions { display: flex; gap: 10px; margin-top: 18px; }
.modal-actions button { flex: 1; height: 44px; border-radius: 12px; background: var(--carbon); border: 0.5px solid var(--hairline); font-weight: 600; }
.modal-actions button.primary { background: var(--gold); color: var(--ink); border-color: transparent; }
.modal-actions button.danger { color: var(--warn); border-color: rgba(229, 72, 77, 0.4); }
.report-actions a.btn { text-decoration: none; }
